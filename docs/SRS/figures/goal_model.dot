// Goal model for Lake in the GRL / i* notation used in SFWRENG 3RA3.
// Positions are pinned (inches); render with:  neato -Tpng goal_model.dot -o goal_model.png
digraph goals {
  layout=neato; dpi=200; pad=0.15; splines=line; overlap=true; outputorder=edgesfirst;
  node [fontname="Helvetica", fontsize=11, color="#333333", pin=true];
  edge [color="#333333", arrowsize=0.9];

  // ---- actor boundaries (drawn first so everything else sits on top) ----
  node [shape=ellipse, style=dashed, color="#666666", fixedsize=true, labelloc=t, fontsize=12];
  A_lake  [label="Lake (the system)",           pos="5.6,3.4!",  width=13.3, height=5.0];
  A_user  [label="Local AI users",              pos="1.7,8.25!", width=3.4,  height=2.6];
  A_org   [label="Regulated small\norganisations", pos="4.8,8.25!", width=3.4, height=2.6];
  A_lab   [label="Researchers",                 pos="7.9,8.25!", width=3.4,  height=2.6];
  A_owner [label="Device owners",               pos="11.0,8.25!", width=2.7, height=2.6];

  // ---- hard goals: rounded boxes ----
  node [shape=box, style="rounded,filled", fillcolor="#e4f0e8", color="#333333", fixedsize=false, labelloc=c, fontsize=11];
  root   [label="Run capable LLMs privately on\nhardware people already own", pos="5.5,5.0!"];
  g_par  [label="Model parallelization\n(PS 2.2)",   pos="0.75,4.0!", fontsize=10];
  g_dyn  [label="Dynamic allocation\n(PS 2.4)",      pos="2.55,4.0!", fontsize=10];
  g_xp   [label="Cross-platform\noperation (PS 2.3)", pos="4.35,4.0!", fontsize=10];
  g_perf [label="Improved local\nperformance (PS 2.1)", pos="6.15,4.0!", fontsize=10];
  g_conc [label="Concurrent\ninference (PS 2.5)", pos="7.95,4.0!", fontsize=10];
  g_priv [label="Request data stays\nin the Lake network",               pos="9.75,4.0!", fontsize=10];
  u_goal [label="Run a model larger than\nmy best machine allows",  pos="1.7,8.62!"];
  o_goal [label="Use an LLM on\nsensitive records",                 pos="4.8,8.58!"];
  r_goal [label="Run large models on\nthe lab's machines",          pos="7.9,8.62!"];

  // ---- plans: hexagons ----
  node [shape=hexagon, style=filled, fillcolor="#f2f2f2", fixedsize=true, width=1.68, height=0.74, fontsize=9.5];
  p_part    [label="Partition the\nmodel by layers",                 pos="0.75,2.6!"];
  p_realloc [label="Reallocate layers when\na device joins or leaves", pos="2.45,2.6!"];
  p_os      [label="Support Windows,\nmacOS and Linux nodes",         pos="4.15,2.6!"];
  p_meas    [label="Measure per-token\ncompute and transfer",    pos="5.85,2.6!"];
  p_pipe    [label="Pipeline several\nrequests through the nodes", pos="7.55,2.6!"];
  p_local   [label="Keep all traffic on\nthe local network",          pos="9.25,2.6!"];
  p_confirm [label="Ask each owner to\nconfirm before joining",       pos="10.95,2.6!"];
  r_script  [label="Script against\nthe API",                         pos="8.75,7.62!", width=1.5, height=0.62];

  // ---- resources: rectangles ----
  node [shape=box, style=filled, fillcolor="#fbe9e7", fixedsize=false, fontsize=11];
  r_gguf    [label="GGUF model file",               pos="4.0,1.4!"];
  r_devices [label="Idle devices on the\nlocal network", pos="6.3,1.4!"];

  // ---- soft goals: clouds ----
  node [shape=none, style="", image="cloud.png", imagescale=true, fixedsize=true, width=1.6, height=0.8, fontsize=10.5];
  u_cost   [label="Low cost",                  pos="0.95,7.62!"];
  u_home   [label="Data stays\nat home",       pos="2.5,7.62!"];
  o_prem   [label="Data never leaves\nthe premises", pos="4.05,7.6!"];
  o_unatt  [label="Works without\nIT attention", pos="5.6,7.6!"];
  r_rep    [label="Repeatable\nmeasurements",  pos="7.15,7.62!"];
  d_ctrl   [label="Control over\nmy device",   pos="11.0,8.62!"];
  d_usable [label="Device stays\nusable",      pos="11.0,7.62!"];

  // ---- "and" labels ----
  node [shape=plaintext, image="", fixedsize=false, fontsize=10, fontcolor="#333333"];
  and_root [label=<<i>and</i>>, pos="5.5,4.58!"];
  and_priv [label=<<i>and</i>>, pos="9.75,3.55!"];

  // ---- decomposition: line with a bar at the child ----
  edge [arrowhead=tee, arrowsize=1.1];
  root -> g_par; root -> g_dyn; root -> g_xp; root -> g_perf; root -> g_conc; root -> g_priv;
  g_par -> p_part; g_dyn -> p_realloc; g_xp -> p_os; g_perf -> p_meas; g_conc -> p_pipe;
  g_priv -> p_local; g_priv -> p_confirm;
  r_goal -> r_script;

  // ---- resources used by plans ----
  edge [arrowhead=normal, color="#777777", arrowsize=0.7];
  r_gguf -> p_part; r_devices -> p_realloc;

  // ---- contributions: green helps, red hurts ----
  edge [arrowhead=normal, arrowsize=0.9, labelfontsize=15, labeldistance=1.6, labelangle=25];
  edge [color="#2e8b57", labelfontcolor="#2e8b57", headlabel="+"];
  g_par  -> u_goal;
  g_xp   -> u_cost;
  g_priv -> u_home;
  g_priv -> o_prem;
  g_dyn  -> o_unatt;
  g_perf -> r_goal;
  g_perf -> r_rep;
  g_conc -> o_goal;
  p_confirm -> d_ctrl;
  edge [color="#c0392b", labelfontcolor="#c0392b", headlabel="−"];
  g_perf -> d_usable;

  // ---- legend ----
  node [shape=plaintext, fontsize=10, style="", fillcolor="", image=""];
  L_box   [shape=box, style="rounded", color="#888888", label="", pos="5.5,0.38!", width=13.0, height=0.75, fixedsize=true];
  L_title [label=<<b>Legend</b>>, pos="-0.3,0.38!"];
  L_actor [shape=ellipse, style=dashed, color="#666666", label="", pos="0.75,0.38!", width=0.7, height=0.42, fixedsize=true];
  L_actor_t [label="actor", pos="1.4,0.38!"];
  L_goal  [shape=box, style="rounded,filled", fillcolor="#e4f0e8", color="#333333", label="", pos="2.15,0.38!", width=0.7, height=0.4, fixedsize=true];
  L_goal_t [label="hard goal", pos="2.95,0.38!"];
  L_soft  [shape=none, style="", image="cloud.png", imagescale=true, fixedsize=true, width=0.8, height=0.42, label="", pos="3.85,0.38!"];
  L_soft_t [label="soft goal", pos="4.6,0.38!"];
  L_res   [shape=box, style=filled, fillcolor="#fbe9e7", color="#333333", label="", pos="5.4,0.38!", width=0.7, height=0.38, fixedsize=true];
  L_res_t [label="resource", pos="6.15,0.38!"];
  L_plan  [shape=hexagon, style=filled, fillcolor="#f2f2f2", color="#333333", label="", pos="7.0,0.38!", width=0.75, height=0.4, fixedsize=true];
  L_plan_t [label="plan", pos="7.6,0.38!"];
  L_d1 [shape=point, width=0.01, pos="8.1,0.38!"]; L_d2 [shape=point, width=0.01, pos="8.7,0.38!"];
  L_d1 -> L_d2 [arrowhead=tee, color="#333333", headlabel="", arrowsize=1.1];
  L_dec_t [label="decomposition", pos="9.45,0.38!"];
  L_c1 [shape=point, width=0.01, pos="10.2,0.38!"]; L_c2 [shape=point, width=0.01, pos="10.75,0.38!"];
  L_c1 -> L_c2 [color="#2e8b57", headlabel="", arrowhead=normal];
  L_cp [label=<<font color="#2e8b57"><b>+</b></font>>, pos="10.9,0.38!"];
  L_c3 [shape=point, width=0.01, pos="11.2,0.38!"]; L_c4 [shape=point, width=0.01, pos="11.75,0.38!"];
  L_c3 -> L_c4 [color="#c0392b", headlabel="", arrowhead=normal];
  L_cm [label=<<font color="#c0392b"><b>−</b></font>>, pos="11.9,0.38!"];
  L_c_t [label="contribution (helps / hurts)", fontsize=8.5, pos="11.1,0.12!"];
}
